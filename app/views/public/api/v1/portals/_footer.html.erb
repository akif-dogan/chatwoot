
<footer class="pt-12 pb-8 flex flex-col items-center justify-center">
  <div class="mx-auto max-w-2xl text-center py-2">
    <p class="text-slate-500 dark:text-slate-400 text-sm font-medium text-center mb-2">
      Need more help?
      <a class="text-blue-600 dark:text-blue-400 hover:underline font-semibold" href="<%= generate_portal_brand_url(@global_config['BRAND_URL'], request.referer) %>" target="_blank" rel="noopener noreferrer nofollow">Contact our team</a>
    </p>
    <div class="flex items-center justify-center gap-2 mt-2">
      <img class="w-4 h-4 opacity-60" alt="<%= @global_config['BRAND_NAME'] %>" src="<%= @global_config['LOGO_THUMBNAIL'] %>" />
      <p class="text-slate-400 dark:text-slate-500 text-xs">
        Powered by <a class="hover:underline" href="<%= generate_portal_brand_url(@global_config['BRAND_URL'], request.referer) %>" target="_blank" rel="noopener noreferrer nofollow"><%= @global_config['BRAND_NAME'] %></a>
      </p>
    </div>
  </div>
</footer>
